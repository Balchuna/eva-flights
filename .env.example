# Token da Travelpayouts (dados Aviasales)
# 1. Criar conta gratis em https://www.travelpayouts.com
# 2. Perfil > API token (ou Tools > API) — copiar o token aqui
# 3. Copiar este arquivo para .env
TRAVELPAYOUTS_TOKEN=

# Opcional: marker de afiliado (painel Travelpayouts)
TRAVELPAYOUTS_MARKER=

# Opcional: SerpAPI (serpapi.com, plano free ~100 buscas/mes) — botao "Verificar preco real" (Google Flights)
SERPAPI_KEY=

# Opcional: RapidAPI (rapidapi.com, assinar Sky-Scrapper no plano Basic free ~100 req/mes) — 2a fonte de busca
RAPIDAPI_KEY=

# Intervalo de checagem dos alertas em horas
ALERT_CHECK_HOURS=6

# Vigilia noturna: horarios fixos (0-23) de checagem extra dos alertas, separados por virgula
WATCH_HOURS=2,4,9,14,20

PORT=3001
