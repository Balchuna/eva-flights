# Token da Travelpayouts (dados Aviasales)
# 1. Criar conta grátis em https://www.travelpayouts.com
# 2. Perfil > API token (ou Tools > API) — copiar o token aqui
# 3. Copiar este arquivo para .env
TRAVELPAYOUTS_TOKEN=

# Opcional: marker de afiliado (painel Travelpayouts)
TRAVELPAYOUTS_MARKER=

# Opcional: SerpAPI (serpapi.com, plano free) — botão "Verificar preço real" (Google Flights)
SERPAPI_KEY=

# Opcional: RapidAPI (rapidapi.com, assinar Sky-Scrapper no plano Basic free) — 2a fonte de busca
RAPIDAPI_KEY=

# Fast-flights: preço do Google Flights por scraper não oficial, sem chave. Pode ir contra os
# termos do Google e quebrar sem aviso. Fica desligado, inclusive sem esta variável.
# Para ligar, por sua conta: FASTFLIGHTS_DISABLED=false
FASTFLIGHTS_DISABLED=true

# Modo demo: preços fictícios, sem chave e sem nenhuma chamada externa
DEMO_MODE=false

# Opcional: pasta dos dados JSON. Vazio usa data/ (data/demo em modo demo)
EVA_DATA_DIR=

# Intervalo de checagem dos alertas em horas
ALERT_CHECK_HOURS=6

# Vigília noturna: horários fixos (0-23) de checagem extra dos alertas, separados por vírgula
WATCH_HOURS=2,4,9,14,20

PORT=3001
